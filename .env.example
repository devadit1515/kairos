# Kairos runs with none of these set.
#
# Every variable below unlocks an additional capability; absent, the relevant
# feature degrades to a local equivalent rather than erroring. Copy this file
# to .env.local and fill in only what you need.

# ---- AI document ingestion ------------------------------------------------
# Without it, /api/ingest uses the deterministic parser in src/lib/extract.ts.
ANTHROPIC_API_KEY=

# ---- Cloud sync (Supabase) ------------------------------------------------
# Without these, all state lives in localStorage. Run supabase/schema.sql
# against a fresh project first — row-level security is defined there and the
# anon key is useless without it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Render Workflows -----------------------------------------------------
# Used by /api/replan to dispatch the nightly re-plan on demand.
RENDER_API_KEY=
KAIROS_WORKFLOW_SLUG=kairos-workflow

# ---- Workflow service only (never expose to the browser) ------------------
# The service-role key bypasses row-level security. It belongs on the workflow
# service and nowhere else.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
